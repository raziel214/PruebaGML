# Copy this file to .env and fill in real values. NEVER commit .env.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=clientes_db
MYSQL_USER=clientes_app
MYSQL_PASSWORD=change-me-app

# ---------- API ----------
API_PORT=8080
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-base64-secret-min-32-bytes
JWT_EXPIRATION=3600000
JWT_ISSUER=clientes-api
BCRYPT_STRENGTH=12
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200

# ---------- Frontend ----------
FRONTEND_PORT=4200
